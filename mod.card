return {
  summary = "Gold Gen 2 voxel/Stadium 2 mod with visible-only roaming encounters by default.",
  author = "Stadium Overworld Models Gen 2 port",
  tags = { "gen2", "gold", "silver", "stadium2", "voxel", "3d", "overworld", "standalone" },
  differences = {
    changed = {
      "uses Gold's current render.compose whole-window hook instead of patching drawWorldBody or relying on the Gen-1 drawWorld pipeline",
      "uses game.data.gen2Encounters / world.encounters with MORN-DAY-NITE Gold tables",
      "uses the embedded Gen-2 renderer and embedded Gen-2-patched Wilds runtime as authoritative standalone components",
      "Stadium pack loading accepts National Dex 1-251",
    },
    added = {
      "v0.2.15 restores Lugia to a real Stadium 2 3D model with runtime hierarchy repair and opaque body textures, and makes overworld Poké Ball throws substantially harder with strength-scaled aim windows, faster precision timing, stricter throw grades, and visible off-target ball flight",
      "v0.2.13 gives Lugia a species-correct opaque world-card fallback instead of the translucent/wrong generic roaming sprite while corrupt Dex-249 Stadium 2 geometry remains rejected",
      "v0.2.13 bridges real continuous 3RD/1ST displacement into the 3D Character Selector walking pose only during rendering, so player animations work without spoofing Gold gameplay movement",
      "v0.2.12 separates Poké Ball aim from throw: hold L2/right mouse for the shoulder camera, then R2/left mouse throws without any automatic Ball use",
      "v0.2.12 adds LOW-to-EXTREME capture resistance from Gen-2 base stats plus encounter level while preserving Gold Ball/catch rules",
      "v0.2.11 makes capture a pre-contact R3/right-click throw from the camera cone and polls Gold input.step so it works while standing still",
      "v0.2.11 uses a dedicated UV-sphere Poké Ball prop/material instead of the scrambled COLLADA atlas mapping",
      "v0.2.10 makes overworld capture reliable through the native Wilds battle-start seam, adds direct C/right-shoulder/right-trigger entry, real mouse clicks, multi-Ball inventory support, and a Poké Ball mesh fallback",
      "v0.2.09 adds dedicated world-space Aeroblast and Sacred Fire signature effects on top of the Gold AnimRunner-powered 3D effect bridge",
      "v0.2.09 adds Gen-2 legendary overworld presence scaling for Raikou, Entei, Suicune, Lugia and Ho-Oh while keeping Celebi naturally small",
      "v0.2.08 wires Gold's real Gen-2 AnimRunner move id/attacker/frame into the world-space Stadium-style 3D attack-effect renderer and adds more Gen-2 signature aliases",
      "v0.2.07 removes Gold's duplicate native 2D player trainer back-sprite from live voxel battle intros, leaving the already-present 3D trainer as the only trainer presentation",
      "v0.2.06 adds a direct-overworld 3D Poké Ball aim/throw/shake capture minigame for visible wild Pokémon, using the supplied ball model and Gold catch/storage structures",
      "v0.2.05 adds resilient desktop F6 camera cycling plus mapped-controller right-stick look in both 3RD and 1ST person while preserving mouse look",
      "v0.2.04 streams each directly connected Gold map as real voxel terrain one area ahead in every available cardinal direction for seamless route/town handoffs",
      "v0.2.03 doubles the real outdoor round-tree apron to 32 tiles per side and makes the smart live battle camera crash-safe on LuaJIT/LÖVE",
      "v0.2.01 adds smooth continuous diorama pinch/wheel camera-distance zoom and an optional Stadium-style smart orbit camera for live-world battles",
      "v0.2.00 adds Android split-thumb look: left controls movement, right open screen steers 1ST/3RD and live-overworld battle cameras",
      "v0.1.95 adds an Android-only in-game DIORAMA/3RD/1ST touch slider while desktop uses F6 for the same camera modes",
      "v0.1.94 fixes pinch zoom on Gold by installing the gesture owner on live Game2 and routing diorama pinch to world:zoomStep",
      "v0.1.93 activates two-finger pinch zoom for the Gold voxel world: smooth third-person boom scaling plus diorama/survey zoom",
      "v0.1.92 makes LIVE OVERWORLD BATTLES seamless by skipping Gold's black-circle encounter transition for ordinary wild encounters",
      "v0.1.91 adds CAMERA CONTROL AUTO/THIS MOD/CHARACTER SELECTOR; AUTO follows red_3d_player's public voxel ZOOM/1ST/3RD camera state",
      "independent 2D visible-Wilds compose fallback when voxel is pending or failed",
      "compose-time Wilds map initialization self-heal with rate limiting",
      "Pokemon Stadium 2 model archive reader at 0x027ED000",
      "Pokemon Stadium 2 skeletal-animation archive reader at 0x02D7D000",
      "Stadium 2 ROM picker for user-supplied z64/n64/v64 files",
      "v0.1.87 adds a Pokemon Yellow-style lead-party follower: party slot #1 trails the player through Gold's native Gen-2 Follower path and is rendered with its Stadium 2 model by default",
      "v0.1.89 keeps ordinary wild battles in the exact frozen overworld voxel camera instead of switching to a separate staged battle camera; Gold's native HUD/menu stays layered over the world",
      "v0.1.89 ships a lean Gen-2-only sprite payload: only National Dex 1-251 prebuilt runtime sheets are included and duplicate raw source atlases are omitted",
    },
    fixed = {
      "v0.2.11 rejects the known-bad Lugia Stadium 2 decode and uses Gold's texture-correct sprite fallback instead of detached blue geometry",
      "v0.2.11 frees right mouse from the Game Boy B mouse mapping and fixes the Poké Ball red/white vertical UV orientation",
      "v0.2.10 fixes the v0.2.06 capture wrapper being bypassable and fixes the documented left/right mouse capture controls that were not actually polled",
      "v0.2.09 fixes Lugia-style detached Stadium 2 model parts by validating full X/Y/Z posed bounds and major-bone travel at runtime, protects already-built DSM4 caches, and keeps rejected clips on the intact 3D bind pose with sprite fallback for an invalid bind",
      "v0.2.08 removes the remaining native 2D player-Pokémon send-out flash when that side already has a loaded Stadium model, while retaining the normal sprite fallback when no model exists",
      "v0.2.07 stops the oversized flat trainer back-pic from being composited over the 3D live battle world during the opening/send-out sequence",
      "v0.2.06 preserves the normal wild-battle path as a fail-safe when capture prerequisites are unavailable and keeps mouse/right-stick camera control active inside the transparent capture state",
      "v0.2.05 makes F6 survive swallowed/replaced Game2 key callbacks by adding an edge-triggered keyboard-state poll, and makes mapped right-stick look survive missing gamepadaxis callbacks by polling rightx/righty every frame",
      "v0.2.04 stops connected Gold routes from being treated as voxel-world edges, masks synthetic forest under real neighbours, reuses prebuilt neighbour meshes on seam entry, and gives camera/follower seam code actual neighbour Map objects",
      "v0.2.03 prevents optional Stadium battle-camera state mismatches from crashing gameplay and falls back to the normal live-world camera",
      "v0.2.00 deepens the outdoor round-tree perimeter belt from 4 to 8 tiles without restoring rectangular border walls",
      "v0.1.95 routes the Android slider and desktop F6 through Character Selector-aware camera selection so red_3d_player remains authoritative when installed",
      "v0.1.94 makes two-finger zoom functional on Gold; v0.1.93 accidentally wrapped the Gen-1 Game touch callbacks instead of the live Game2 host",
      "v0.1.93 installs CamControl after FirstPerson so pinch zoom is reachable without also rotating the touch-look camera",
      "v0.1.92 removes the native black-circle battle wipe when LIVE OVERWORLD BATTLES is ON, so seamless encounters no longer transition to a different scene",
      "v0.1.91 stops the standalone Gold renderer from overwriting Character Selector's third-person camera, forwards external look input, and stands down its cardinal movement remapper while red_3d_player owns the camera",
      "v0.1.89 bypasses Gold BattleAnimView's opaque white/scanline background pass during live-world battles, preventing the black/white 160x144 rectangle that flashed during attacks",
      "v0.1.88 fixes the black-and-white voxel world and keeps animated water/flower copies on the same Gold palette bake instead of raw grayscale source art",
      "Gold's grouped gen2Encounters grass/water database now feeds visible roaming spawns",
      "Wilds entities no longer depend on Gold's native people pass, which ignores non-NPC world.entities",
      "fallback Wilds draw starts from a clean graphics origin so inherited transforms cannot hide sprites",
      "hidden encounter behaviors remain off and v0.1.70 Random Enc saves migrate to visible-only mode",
      "ordinary Gold step encounters, including the roamer-before-hook path, are gated when Classic Step Enc is OFF",
      "v0.1.74 keeps Gold START/textbox overlays visible above the voxel world by redrawing the live Game2 stack",
      "v0.1.75 lets red_3d_player's live Skin Selector renderer own the human Gold player inside the standalone voxel scene, including dynamic skin changes",
      "v0.1.76 replaces Gold outdoor tree-border and unresolved tree fallback boxes with the profile-driven round voxel-tree hull path",
      "v0.1.77 gives Johto tree-wall art an explicit stepped canopy/trunk voxel profile so edge-filled tree textures cannot resolve back into rectangular masses",
      "v0.1.87 removes the accidental v0.1.84/v0.1.85 true-360 movement and red_3d_player animation override from this project; First/Third Person return to v0.1.80 camera-relative cardinal Gold movement so external character animation mods stay authoritative",
      "v0.1.87 fixes the live Gold battle session bug where `isGoldGame() and nil or battle` stored the Gen-2 logic object instead of waiting for the real Gen2BattleState screen",
      "v0.1.89 removes dead Gen-1 Yellow follower/free-move/old Dramatic entry modules and strips legacy Followers EX / Dramatic Sky Ride startup glue from this Gen-2-only package",
      "v0.1.83 fixes the v0.1.82 voxel startup regression, keeps the outdoor weather/cloud/sun/moon presentation, and makes every weather hook fail-safe so weather cannot disable voxel 3D",
      "v0.1.78 bridges current Gold TILESET_* runtime names to the voxel profile's Tileset* names, activating the authored Johto tree/canopy geometry instead of generic solid blocks",
      "v0.1.77 keeps Stadium 2 overworld species in 3D bind pose when provisional Gen-2 animation validation marks them static, and accepts speciesId/dexId aliases",
      "retains the v0.1.65 Mods -> Options crash fix",
    },
    known = {
      "Stadium 2 move/context animation semantic routing is provisional",
      "real Gold GPU/gameplay verification must be performed in Gen1Recomp",
      "no Nintendo ROM or extracted Stadium 2 model assets are included",
    },
