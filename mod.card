return {
  summary = "Gold Gen 2 voxel/Stadium 2 mod with visible-only roaming encounters by default.",
  author = "Stadium Overworld Models Gen 2 port",
  tags = { "gen2", "gold", "silver", "stadium2", "voxel", "3d", "overworld", "standalone" },
  differences = {
    changed = {
      "uses Gold's current render.compose whole-window hook instead of patching drawWorldBody or relying on the Gen-1 drawWorld pipeline",
      "uses game.data.gen2Encounters / world.encounters with MORN-DAY-NITE Gold tables",
      "uses the embedded Gen-2 renderer and embedded Gen-2-patched Wilds runtime as authoritative standalone components",
      "Stadium pack loading accepts National Dex 1-251",
    },
    added = {
      "independent 2D visible-Wilds compose fallback when voxel is pending or failed",
      "compose-time Wilds map initialization self-heal with rate limiting",
      "Pokemon Stadium 2 model archive reader at 0x027ED000",
      "Pokemon Stadium 2 skeletal-animation archive reader at 0x02D7D000",
      "Stadium 2 ROM picker for user-supplied z64/n64/v64 files",
      "v0.1.85 IN-WORLD 3D BATTLES option: Gold battle UI/logic over the exact voxel encounter-site terrain, sky and weather with Stadium 2 combatants",
    },
    fixed = {
      "Gold's grouped gen2Encounters grass/water database now feeds visible roaming spawns",
      "Wilds entities no longer depend on Gold's native people pass, which ignores non-NPC world.entities",
      "fallback Wilds draw starts from a clean graphics origin so inherited transforms cannot hide sprites",
      "hidden encounter behaviors remain off and v0.1.70 Random Enc saves migrate to visible-only mode",
      "ordinary Gold step encounters, including the roamer-before-hook path, are gated when Classic Step Enc is OFF",
      "v0.1.74 keeps Gold START/textbox overlays visible above the voxel world by redrawing the live Game2 stack",
      "v0.1.75 lets red_3d_player's live Skin Selector renderer own the human Gold player inside the standalone voxel scene, including dynamic skin changes",
      "v0.1.76 replaces Gold outdoor tree-border and unresolved tree fallback boxes with the profile-driven round voxel-tree hull path",
      "v0.1.77 gives Johto tree-wall art an explicit stepped canopy/trunk voxel profile so edge-filled tree textures cannot resolve back into rectangular masses",
      "v0.1.85 feeds v0.1.84 continuous free-walk motion into red_3d_player only during its voxel render calls, restoring walk/run animation without setting Gold Player.moving or starting native grid interpolation",
      "v0.1.84 adds true continuous 360-degree normal walking in Gold First/Third Person: unquantised camera-relative analog/diagonal travel, circular collision with wall sliding, continuous player-model facing, and native Gold landing events; bike/surf/forced/scripted movement stays grid-owned",
      "v0.1.83 fixes the v0.1.82 voxel startup regression, keeps the outdoor weather/cloud/sun/moon presentation, and makes every weather hook fail-safe so weather cannot disable voxel 3D",
      "v0.1.78 bridges current Gold TILESET_* runtime names to the voxel profile's Tileset* names, activating the authored Johto tree/canopy geometry instead of generic solid blocks",
      "v0.1.77 keeps Stadium 2 overworld species in 3D bind pose when provisional Gen-2 animation validation marks them static, and accepts speciesId/dexId aliases",
      "retains the v0.1.65 Mods -> Options crash fix",
