    added = {
      "v0.4.33 adds first-class Crystal support: Crystal-aware mobile picker routing, edition-separated voxel disk caches, host version/engine exports, Crystal-inclusive Gen-2 runtime messaging, and MYSTICALMAN/Eusine announcer scope",
